<?xml version="1.0"?>

<robot name="simple_car">
    <link name= "world"/>

    <joint name='fixed' type='fixed'>
        <parent link="world"/>
        <child link='base_link'/>
    </joint>



    <link name = "base_link">
        <visual>
            <geometry>
                <box size = "1.5 0.75 0.3"></box>
            </geometry>
            <origin xyz="0 0 0.15"></origin>
            <material name="blue">
                <color rgba="0 0 1 1"></color>
            </material>
        </visual>
    </link>

    <joint name="joint_front_left" type="fixed">
        <parent link="base_link"/>
        <child link="wheel_front_left"/>
        <origin xyz="0.6 0.425 0.075" rpy="0 0 0"/>
    </joint>

    <link name="wheel_front_left">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
    </link>

    <joint name="joint_front_right" type="fixed">
        <parent link="base_link"/>
        <child link="wheel_front_right"/>
        <origin xyz="0.6 -0.425 0.075" rpy="0 0 0"/>
    </joint>

    <link name="wheel_front_right">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
    </link>

    <joint name="joint_behind_right" type="fixed">
        <parent link="base_link"/>
        <child link="wheel_behind_right"/>
        <origin xyz="-0.6 -0.425 0.075" rpy="0 0 0"/>
    </joint>

    <link name="wheel_behind_right">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
    </link>

    <joint name="joint_behind_left" type="fixed">
        <parent link="base_link"/>
        <child link="wheel_behind_left"/>
        <origin xyz="-0.6 0.425 0.075" rpy="0 0 0"/>
    </joint>

    <link name="wheel_behind_left">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.15" length="0.1"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
    </link>
</robot>